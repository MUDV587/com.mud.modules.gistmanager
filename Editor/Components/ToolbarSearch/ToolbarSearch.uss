/* ToolbarSearch：工具栏搜索框 */

.gm-toolbar-search {
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 100px;
    max-width: 200px;
    flex-direction: row;
    align-items: center;
    height: 18px;
    min-height: 18px;
    margin: 1px 4px 1px 0;
    padding: 0 2px 0 2px;
    background-color: rgb(42, 42, 42);
    border-width: 1px;
    border-color: rgb(70, 70, 70);
    border-radius: 4px;
}

.gm-toolbar-search:hover {
    background-color: rgb(50, 50, 50);
    border-color: rgb(90, 90, 90);
}

/* 通过控制器切换 .focused class（与 GistManagerWindowRoot 同款手法；:focus-within 不是 2022.3 的合法伪类） */
.gm-toolbar-search.focused {
    border-color: rgb(55, 142, 231);
}

/* 放大镜（官方 8x8）—icon 渲染 8x8，与 d_search_icon.png 的原生分辨率一致 */
.gm-toolbar-search__icon {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    min-width: 8px;
    margin: 0 1px 0 2px;
    background-image: url("project://database/Packages/com.mud.modules.gistmanager/Editor/Icons/d_search_icon.png?fileID=2800000&guid=26cf6dbf64a7377439601ddf3d77653a&type=3#d_search_icon");
    background-size: contain;
    background-position: center center;
    -unity-background-scale-mode: scale-to-fit;
}

/* 文本输入框：透明背景 */
.gm-toolbar-search .gm-toolbar-search__input {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 14px;
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    box-shadow: none;
    outline-width: 0;
    color: rgb(238, 238, 238);
    font-size: 11px;
    padding: 0 2px;
    margin: 0;
}

.gm-toolbar-search .gm-toolbar-search__input:hover,
.gm-toolbar-search .gm-toolbar-search__input:focus {
    border-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    box-shadow: none;
    outline-width: 0;
}

/* 禁用内层 TextInput 的蓝色边框：整框高亮由外层 .focused 负责 */
.gm-toolbar-search .unity-text-field__input,
.gm-toolbar-search .unity-base-field__input,
.gm-toolbar-search .unity-base-text-field__input,
.gm-toolbar-search .unity-base-text-field__input--single-line {
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    box-shadow: none;
    outline-width: 0;
}

.gm-toolbar-search .gm-toolbar-search__input:focus > .unity-text-input__input {
    color: rgb(255, 255, 255);
}

/* 清空按钮：默认隐藏，has-text 类出现时显示 */
.gm-toolbar-search .gm-toolbar-search__clear {
    display: none;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    min-width: 14px;
    padding: 0;
    margin: 0 0 0 2px;
    border-width: 0;
    border-radius: 7px;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    color: rgb(180, 180, 180);
    font-size: 12px;
    -unity-font-style: bold;
}

.gm-toolbar-search .gm-toolbar-search__clear:hover {
    background-color: rgba(70, 70, 70, 0.8);
    color: rgb(255, 255, 255);
}

.gm-toolbar-search.has-text .gm-toolbar-search__clear {
    display: flex;
}
