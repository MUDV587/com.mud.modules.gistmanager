/* gistDetails 组件样式
   所有选择器都基于 .gm-gist-details 作用域，不依赖宿主窗口 ID，
   这样同一份 UXML+USS+Controller 可以放进任意窗口复用。 */

.gm-gist-details {
    flex: 1 0 0;
    flex-direction: column;
    position: relative;
    background-color: rgb(43, 41, 43);
}

.gm-gist-details #detailScrollView {
    flex: 1 1 auto;
}

.gm-gist-details .unity-button {
    -unity-text-align: middle-center;
}

.gm-gist-details .font-big {
    font-size: 12px;
}

.gm-gist-details .container {
    flex: 1 0 auto;
    flex-direction: column;
    margin: 0 0 4px 0;
}

.gm-gist-details .containerTitle {
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 0;
    padding-bottom: 2px;
}

.gm-gist-details .row {
    flex-direction: row;
}

/* === 多选模式 === */
.gm-gist-details #multiSelectDetailsHeader {
    background-color: rgb(48, 48, 48);
    border-bottom-width: 1px;
    border-color: rgb(35, 35, 35);
    padding: 10px 0 10px 5px;
}

.gm-gist-details #multiSelectDetails #multiSelectTitle {
    font-size: 19px;
    -unity-font-style: bold;
    white-space: normal;
    margin: 0;
    flex-shrink: 1;
}

.gm-gist-details #multiSelectInfoBoxContainer {
    border-bottom-width: 1px;
    border-color: rgb(35, 35, 35);
    padding: 6px;
}

/* === 详情头 === */
.gm-gist-details .detail #detailsHeader {
    background-color: rgb(56, 56, 56);
    padding: 10px 8px 0 8px;
}

.gm-gist-details .titleBar {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    flex: 0 0 auto;
    margin: 0 4px 0 0;
    padding-left: 0;
    justify-content: space-between;
    height: 29px;
}

.gm-gist-details .titleBar #detailTitle {
    font-size: 19px;
    -unity-font-style: bold;
    white-space: nowrap;
    margin: 0;
    flex: 1 1 0;
    padding-left: 0;
    text-overflow: ellipsis;
    overflow: hidden;
    min-width: 100px;
    height: 29px;
    align-self: center;
}

.gm-gist-details .titleBar .gm-details-toolbar {
    flex-shrink: 0;
    flex-grow: 0;
    align-self: center;
    flex-direction: row;
    height: 25px;
}

.gm-gist-details .gm-details-toolbar #toolbarMain {
    flex-direction: row;
}

.gm-gist-details .gm-details-toolbar .rightItems {
    flex: 1 0 auto;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    margin-right: 4px;
}

.gm-gist-details .gm-details-toolbar .unity-button {
    flex: 0 0 auto;
    height: 20px;
    min-width: 73px;
    margin: 3px 4px;
    padding: 0 6px;
    overflow: visible;
    -unity-text-align: middle-center;
}

/* === 版本区 === */
.gm-gist-details .versionContainer {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: wrap;
    margin-left: 0;
    padding-left: 0;
    margin-top: 4px;
    height: 22px;
}

.gm-gist-details .versionContainer #detailVersion {
    flex: 0 0 auto;
    height: 18px;
    margin: 0;
    -unity-font-style: bold;
}

/* === 名称区 === */
.gm-gist-details .leftRightAlign {
    flex-direction: row;
    align-items: center;
}

.gm-gist-details .leftRightAlign .leftAlign {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    flex-wrap: wrap;
}

.gm-gist-details .leftRightAlign .rightAlign {
    flex-shrink: 0;
    flex-grow: 0;
    align-self: flex-end;
}

.gm-gist-details #detailName {
    font-size: 12px;
    min-height: 20px;
    -unity-font-style: italic;
    text-overflow: ellipsis;
    overflow: hidden;
}

/* === 自定义 / 扩展 === */
.gm-gist-details #detailCustomContainer {
    margin: 0;
    padding-bottom: 4px;
    background-color: rgb(56, 56, 56);
}

.gm-gist-details #detailExtensionContainer {
    margin: 0;
    padding-bottom: 4px;
    background-color: rgb(56, 56, 56);
}

/* === 页签 === */
.gm-gist-details #gistDetailsTabView .headerRow {
    background-color: rgb(56, 56, 56);
}

.gm-gist-details #gistDetailsTabView .tabsheaderRow {
    margin: 0;
    flex-grow: 0;
}

.gm-gist-details #gistDetailsTabView .tabsheaderRow .unity-button {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    font-size: 11.5px;
    padding-bottom: 5px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.gm-gist-details #gistDetailsTabView .tabsheaderRow .unity-button:hover {
    background-color: rgb(80, 80, 80);
}

.gm-gist-details #gistDetailsTabView .tabsheaderRow .unity-button.tabHeaderSelected {
    background-color: rgb(60, 60, 60);
    border-bottom-color: rgb(255, 255, 255);
    border-bottom-width: 1px;
}

/* === 描述页 === */
.gm-gist-details .gistDetailsDescriptionTab {
    margin: 10px 0 4px 8px;
}

.gm-gist-details #detailDescription {
    white-space: normal;
    overflow: hidden;
}

.gm-gist-details #detailDescription.empty {
    -unity-font-style: italic;
}

.gm-gist-details #detailSourcePath {
    white-space: normal;
}
